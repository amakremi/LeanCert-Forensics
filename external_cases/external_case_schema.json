{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "source_organization", "provenance", "collection_date",
    "public_data", "labels_independently_supplied", "annotator",
    "annotation_method", "evidence_artifacts", "actors", "events", "claims",
    "ground_truth_validity", "ground_truth_violated_requirements", "uncertainty_notes"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "source_organization": {"type": "string", "minLength": 1},
    "provenance": {"type": "string", "minLength": 1},
    "collection_date": {"type": "string", "minLength": 1},
    "public_data": {"type": "boolean"},
    "labels_independently_supplied": {"type": "boolean"},
    "annotator": {"type": "string", "minLength": 1},
    "annotation_method": {"type": "string", "minLength": 1},
    "inter_annotator_agreement": {"type": ["number", "null"]},
    "evidence_artifacts": {"type": "array"},
    "actors": {"type": "array"},
    "events": {"type": "array"},
    "claims": {"type": "array"},
    "ground_truth_validity": {"enum": ["valid", "invalid", "uncertain"]},
    "ground_truth_violated_requirements": {"type": "array", "items": {"type": "string"}},
    "uncertainty_notes": {"type": "string"}
  }
}
